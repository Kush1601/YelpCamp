# PostgreSQL (PostGIS + pgvector) — docker compose: npm run db:migrate && npm run db:seed
DATABASE_URL=postgres://yelpcamp:yelpcamp@localhost:5432/yelpcamp

# App URL for server-side fetches (local dev: http://localhost:3000 | prod: https://yelpcamp-topaz.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Anthropic — Claude Haiku powers semantic query expansion for similar search (optional for local dev)
ANTHROPIC_API_KEY=

# Cloudinary (optional — new listings can use image URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
